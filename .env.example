# Tencent Cloud TokenHub example. Keep the real key only in a private environment.
HY3_API_PROVIDER=tokenhub
HY3_BASE_URL=https://tokenhub.tencentmaas.com/v1
HY3_API_KEY=replace-with-your-key
HY3_MODEL=hy3-preview
HY3_REASONING_EFFORT=high
HY3_MAX_TOKENS=16000
HY3_TEMPERATURE=0.9
HY3_TOP_P=1.0
HY3_TIMEOUT_SECONDS=300
HY3_MAX_RETRIES=2

# For a local vLLM/SGLang endpoint, use:
# HY3_API_PROVIDER=self_hosted
# HY3_BASE_URL=http://127.0.0.1:8000/v1
# HY3_API_KEY=EMPTY
# HY3_MODEL=hy3

# Migrated ReproScope application behavior inside ReproEval.
REPROSCOPE_WORKSPACE=.reproeval/reproscope
# Multiple roots use the OS path separator: ';' on Windows, ':' on Linux/macOS.
REPROSCOPE_ALLOWED_ROOTS=.
REPROSCOPE_MAX_FILE_MB=50
REPROSCOPE_MAX_SOURCE_CHARS=24000
REPROSCOPE_MAX_TOTAL_CHARS=120000
REPROSCOPE_PROMPT_INJECTION_POLICY=reject
REPROSCOPE_LOG_LEVEL=INFO
